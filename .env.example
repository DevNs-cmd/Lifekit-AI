# ──────────────────────────────────────────────
# LifeKit - Production & Local Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your actual production/staging values.
# Never commit actual production .env files to Git.

# ─── 1. Next.js Web Frontend ──────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── 2. NestJS Core Backend ───────────────────
PORT=4000
DATABASE_URL=postgresql://lifekit:lifekit@localhost:5434/lifekit?schema=public
REDIS_URL=redis://localhost:6380
JWT_SECRET=change-me-to-a-highly-secure-jwt-secret-key-32-chars
JWT_REFRESH_SECRET=change-me-to-a-highly-secure-jwt-refresh-secret-key-32-chars
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
AI_SERVICE_URL=http://localhost:8000

# ─── 3. OAuth Social Authentication ────────────
# Google OAuth 2.0 Client Credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# GitHub OAuth App Credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# LinkedIn OAuth 2.0 Credentials (https://www.linkedin.com/developers/apps)
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_CALLBACK_URL=http://localhost:4000/api/auth/linkedin/callback

# ─── 4. Razorpay Payment Gateway ───────────────
# Required for live INR subscription and marketplace payments.
# If keys are omitted or set to placeholders, system uses Sandbox simulation mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me-to-your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ─── 5. Stripe Payment Gateway ─────────────────
# Required for international USD/EUR marketplace & subscription billing.
STRIPE_SECRET_KEY=sk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── 6. FastAPI AI Service & Vector DB ──────────
AI_SERVICE_PORT=8000
AI_SERVICE_DATABASE_URL=postgresql://lifekit:lifekit@localhost:5434/lifekit
AI_SERVICE_REDIS_URL=redis://localhost:6380
AI_SERVICE_QDRANT_URL=http://localhost:6333
AI_SERVICE_OPENAI_API_BASE=https://openrouter.ai/api/v1
AI_SERVICE_OPENAI_MODEL=openrouter/free
AI_SERVICE_OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_SERVICE_OPENAI_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_SERVICE_FALLBACK_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_SERVICE_FALLBACK_API_BASE=https://openrouter.ai/api/v1
AI_SERVICE_FALLBACK_MODEL=openai/gpt-4o

# ─── 7. Background Worker ─────────────────────
WORKER_REDIS_URL=redis://localhost:6380
WORKER_DATABASE_URL=postgresql://lifekit:lifekit@localhost:5434/lifekit

# ─── 8. PostgreSQL & Redis Infrastructure ─────
POSTGRES_USER=lifekit
POSTGRES_PASSWORD=lifekit
POSTGRES_DB=lifekit
REDIS_PASSWORD=

# ─── 9. S3-Compatible Object Storage ──────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lifekit-files
S3_REGION=us-east-1

# ─── 10. Email Service (SMTP / Resend) ─────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM=no-reply@lifekit.ai

# ─── 11. Application Monitoring & Logging ─────
SENTRY_DSN=https://xxxxxxxx.ingest.sentry.io/xxxxxxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx.ingest.sentry.io/xxxxxxxx
