# ──────────────────────────────────────────────
# LifeKit - Environment Variables (Example)
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env files to Git.

# ─── Next.js Frontend ──────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ─── NestJS Core Backend ───────────────────────
PORT=4000
DATABASE_URL=postgresql://lifekit:lifekit@localhost:5432/lifekit?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-highly-secure-jwt-secret-key-32-chars
JWT_REFRESH_SECRET=change-me-to-a-highly-secure-jwt-refresh-secret-key-32-chars
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
AI_SERVICE_URL=http://localhost:8000

# ─── FastAPI AI Service ────────────────────────
AI_SERVICE_PORT=8000
AI_SERVICE_DATABASE_URL=postgresql://lifekit:lifekit@localhost:5433/lifekit
AI_SERVICE_REDIS_URL=redis://localhost:6380
AI_SERVICE_QDRANT_URL=http://localhost:6333
AI_SERVICE_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_SERVICE_FALLBACK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_SERVICE_FALLBACK_API_BASE=https://api.openai.com/v1
AI_SERVICE_FALLBACK_MODEL=gpt-4o

# ─── Background Worker ─────────────────────────
WORKER_REDIS_URL=redis://localhost:6380
WORKER_DATABASE_URL=postgresql://lifekit:lifekit@localhost:5433/lifekit

# ─── PostgreSQL ────────────────────────────────
POSTGRES_USER=lifekit
POSTGRES_PASSWORD=lifekit
POSTGRES_DB=lifekit

# ─── Redis ─────────────────────────────────────
REDIS_PASSWORD=

# ─── S3-Compatible Storage ─────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lifekit-files
S3_REGION=us-east-1

