# ──────────────────────────────────────────────
# LifeKit API - Local Environment Configuration
# ──────────────────────────────────────────────

# Host & Port settings
PORT=4000
NODE_ENV=development

# Database Settings (PostgreSQL 18)
DATABASE_URL=postgresql://lifekit:lifekit@localhost:5432/lifekit?schema=public

# Cache Settings (Redis)
REDIS_URL=redis://localhost:6379

# Authentication (JWT)
JWT_SECRET=change-me-to-a-highly-secure-jwt-secret-key-32-chars
JWT_REFRESH_SECRET=change-me-to-a-highly-secure-jwt-refresh-secret-key-32-chars

# CORS Origin Settings (comma-separated if multiple)
CORS_ORIGIN=http://localhost:3000

# External Service Integrations
AI_SERVICE_URL=http://localhost:8000
